# Environment
DATABASE_URL="postgresql://user:password@host:port/dbname"
DIRECT_URL="postgresql://user:password@host:port/dbname"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your_nextauth_secret_here"

# Google Auth (for login)
GOOGLE_CLIENT_ID="your_google_id_here"
GOOGLE_CLIENT_SECRET="your_google_secret_here"

# Seedance V2 API (for image/video logic)
SEEDANCE_V2_API_KEY="your_seedance_v2_key_here"
WEBHOOK_URL="your_webhook_url"
WEBHOOK_SECRET="any_long_random_string_here"

# OpenAI (Build my reference image generation — gpt-image-1)
# Generate at platform.openai.com/api-keys, then add to Vercel env vars.
OPENAI_API_KEY="sk-proj-..."

# Stripe (for payments)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Dynamic UI Theme Configuration
# Hosted Admins: Choose between: indigo, emerald, rose, amber, violet
NEXT_PUBLIC_THEME=indigo

# Cloudflare R2 Storage (own video CDN — zero egress fees)
# Setup: dash.cloudflare.com → R2 → Create bucket → Manage R2 API tokens
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="seedance-videos"
# Public URL: either r2.dev subdomain or your custom domain
# e.g. https://pub-xxxx.r2.dev  OR  https://videos.seedance.visualseffect.com
R2_PUBLIC_URL="https://pub-xxxx.r2.dev"
