generator client {
  provider      = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  credits       Int        @default(10)
  verified      Boolean    @default(false)
  // Mirrors the column the community project already pushed to the
  // shared Neon DB. Declaring it here so Studio's Prisma client can
  // read/sort by it — primarily to keep paying filmmakers on top and
  // community-seed dummies pinned to the bottom in /admin → Filmmakers.
  // No new column added to the DB; this is just a Prisma-client view.
  isDummy       Boolean    @default(false)
  // Push-notification preferences for Studio. Single master switch +
  // three per-type toggles, matching the Settings panel in the
  // /demo/push-notifications mockup. Defaults to all-on so users who
  // opt in via the contextual banner get the full set immediately.
  pushMaster      Boolean @default(true)
  pushVideoReady  Boolean @default(true)
  pushVideoFailed Boolean @default(true)
  pushFeatured    Boolean @default(true)
  accounts      Account[]
  creations     Creation[]
  sessions      Session[]
  payments      Payment[]
  comments      Comment[]
  following     Follow[]   @relation("Follower")
  followers     Follow[]   @relation("Following")
  notifications     Notification[] @relation("NotifRecipient")
  notificationsSent Notification[] @relation("NotifActor")
  posts             Post[]
  reactions         Reaction[]
  pushSubscriptions PushSubscription[]
}

model Creation {
  id          String   @id @default(cuid())
  prompt      String
  imageUrl    String?
  aspectRatio String?
  resolution  String?
  createdAt   DateTime @default(now())
  userId      String
  error       String?
  requestId   String?  @unique
  status      String   @default("processing")
  duration    Int?
  quality     String?
  audioFiles  String[]
  videoFiles  String[]
  inputImages String[]
  featured    Boolean  @default(false)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments    Comment[]
  notifications Notification[]

  @@index([userId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
}

// Community follow graph — Instagram-style follower / following relationships.
// Owned by seedance-community at community.visualseffect.com.
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

// Community comments — added by seedance-community at community.visualseffect.com.
// Polymorphic: attached to a Creation (video) OR a community Post. Exactly
// one of creationId / postId is set; enforced at the community API layer.
model Comment {
  id         String    @id @default(cuid())
  body       String
  userId     String
  creationId String?
  postId     String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  creation   Creation? @relation(fields: [creationId], references: [id], onDelete: Cascade)
  post       Post?     @relation(fields: [postId],     references: [id], onDelete: Cascade)
  notifications Notification[]
  reactions     Reaction[]

  @@index([creationId, createdAt(sort: Desc)])
  @@index([postId,     createdAt(sort: Desc)])
  @@index([userId])
}

// Community-native posts — text + optional image, distinct from
// Creations (AI-generated videos owned by Seedance).
model Post {
  id        String     @id @default(cuid())
  body      String?
  imageUrl  String?
  userId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions Reaction[]
  comments  Comment[]
  // Mirrors the model owned by seedance-community — declared here so
  // the Studio Prisma client can read pinned-state when it shows
  // shared posts in /admin. Side-table, never touched by Studio code.
  pinned    PinnedPost?
  // Phase 2 — Instagram-style profile pin. Same comment as `pinned`
  // above: mirrored from community so the shared client stays valid.
  profilePin ProfilePin?

  @@index([userId])
  @@index([createdAt(sort: Desc)])
}

// Polymorphic reactions — exactly one of postId / commentId is set.
// Type is "like" | "love" (Facebook-style two-button affordance).
model Reaction {
  id        String   @id @default(cuid())
  userId    String
  type      String
  postId    String?
  commentId String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post?    @relation(fields: [postId],    references: [id], onDelete: Cascade)
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, postId, type])
  @@unique([userId, commentId, type])
  @@index([postId])
  @@index([commentId])
}

// Inbox-style notifications — Instagram/Facebook pattern.
// type values: "comment" | "follow" | "new_post"
model Notification {
  id         String   @id @default(cuid())
  userId     String   // recipient
  actorId    String   // user who triggered the action
  type       String
  creationId String?
  commentId  String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  user     User      @relation("NotifRecipient", fields: [userId],     references: [id], onDelete: Cascade)
  actor    User      @relation("NotifActor",     fields: [actorId],    references: [id], onDelete: Cascade)
  creation Creation? @relation(fields: [creationId], references: [id], onDelete: Cascade)
  comment  Comment?  @relation(fields: [commentId],  references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, read])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Tracks fulfilled Stripe checkout sessions — prevents double-crediting
// when both the webhook and the success-page verify endpoint run.
model Payment {
  id              String   @id @default(cuid())
  stripeSessionId String   @unique
  userId          String
  credits         Int
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Tracks site visitors — IP, geolocation, page, user agent
model Visit {
  id        String   @id @default(cuid())
  ip        String
  country   String?
  city      String?
  region    String?
  isp       String?
  page      String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([ip])
  @@index([createdAt])
}


// Admin-pinned posts for community.visualseffect.com. Owned by the
// community project — Studio mirrors the model so the shared Prisma
// client stays in sync after `db push` from either side. Studio code
// does not write to this table.
model PinnedPost {
  id         String   @id @default(cuid())
  postId     String   @unique
  pinnedById String
  kind       String   @default("feature")
  priority   Int      @default(100)
  reason     String?  @db.Text
  pinnedAt   DateTime @default(now())
  expiresAt  DateTime?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([priority, pinnedAt(sort: Desc)])
  @@index([expiresAt])
  @@index([pinnedById])
}

// Phase 2 — user profile pins (Instagram-style). Mirrored here so the
// Studio Prisma client stays valid after `db push`. Studio never
// writes to this table.
model ProfilePin {
  id        String   @id @default(cuid())
  userId    String
  postId    String   @unique
  position  Int      @default(100)
  pinnedAt  DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([userId, position])
  @@index([postId])
}


// Web Push subscription for browser notifications. Mirrors the model
// owned by seedance-community (same shared Neon DB). The `origin`
// column scopes by app: "studio" rows are fanout targets for the
// Studio MuAPI webhook ("video ready" / failed / featured); existing
// "community" rows stay routed to the community fanout. Null in
// legacy rows is treated as community by the API for back-compat.
//
// One row per (userId, endpoint) since `endpoint` is globally unique
// — re-subscribing on the same device upserts on endpoint.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  // "studio" | "community" — null = legacy community row.
  origin    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, origin])
}


// Push-notification token registry. The mobile app (Capacitor) posts
// its FCM (Android) / APNS (iOS) token to /api/devices/register on
// launch. We send "your video is ready" + future engagement pushes
// by joining this on userId.
//
// Standalone — no relation back to User on purpose. Adding a Devices[]
// field on User would touch the auth-critical model and Arman has had
// 3 cookie-bloat incidents from auth-table migrations. Querying by
// userId from this side works fine without the back-reference.
model Device {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  platform   String   // "ios" | "android" | "web"
  appVersion String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  lastSeenAt DateTime @default(now())
  // Set when a push fails with INVALID_REGISTRATION / NotRegistered —
  // the cron sweeps these monthly. Null means token is still good.
  invalidAt  DateTime?

  @@index([userId])
  @@index([invalidAt])
}
