generator client {
  provider      = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  credits       Int        @default(10)
  verified      Boolean    @default(false)
  accounts      Account[]
  creations     Creation[]
  sessions      Session[]
  payments      Payment[]
}

model Creation {
  id          String   @id @default(cuid())
  prompt      String
  imageUrl    String?
  aspectRatio String?
  resolution  String?
  createdAt   DateTime @default(now())
  userId      String
  error       String?
  requestId   String?  @unique
  status      String   @default("processing")
  duration    Int?
  quality     String?
  audioFiles  String[]
  videoFiles  String[]
  inputImages String[]
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Tracks fulfilled Stripe checkout sessions — prevents double-crediting
// when both the webhook and the success-page verify endpoint run.
model Payment {
  id              String   @id @default(cuid())
  stripeSessionId String   @unique
  userId          String
  credits         Int
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
