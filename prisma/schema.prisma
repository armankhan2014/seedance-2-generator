generator client {
  provider      = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  credits       Int        @default(10)
  verified      Boolean    @default(false)
  // Mirrors the column the community project already pushed to the
  // shared Neon DB. Declaring it here so Studio's Prisma client can
  // read/sort by it — primarily to keep paying filmmakers on top and
  // community-seed dummies pinned to the bottom in /admin → Filmmakers.
  // No new column added to the DB; this is just a Prisma-client view.
  isDummy       Boolean    @default(false)
  // Push-notification preferences for Studio. Single master switch +
  // three per-type toggles, matching the Settings panel in the
  // /demo/push-notifications mockup. Defaults to all-on so users who
  // opt in via the contextual banner get the full set immediately.
  pushMaster      Boolean @default(true)
  pushVideoReady  Boolean @default(true)
  pushVideoFailed Boolean @default(true)
  pushFeatured    Boolean @default(true)
  // ── Admin Signups Tracker fields (added 2026-06-02) ────────────────
  // createdAt is the source-of-truth signup date. Nullable so existing
  // rows that don't have one yet don't break the migration — those
  // accounts can be backfilled from Account.createdAt in a follow-up
  // script. New signups get @default(now()) automatically.
  createdAt   DateTime? @default(now())
  // Vercel edge geolocation captured in NextAuth's createUser event by
  // reading x-vercel-ip-* headers via next/headers headers(). All
  // optional because (a) users may opt out of location tracking later
  // and (b) non-Vercel deploys (local dev) don't get these headers.
  country     String?   @db.VarChar(2) // ISO-3166-1 alpha-2 (e.g. "GB")
  region      String?
  city        String?
  latitude    Float?
  longitude   Float?
  // First request IP for fraud detection. Stored as text; encryption at
  // rest is handled by Neon/Postgres TDE. Never displayed outside admin.
  ipAddress   String?
  // Where the signup came from: "direct", "oauth_google", "oauth_apple",
  // "referral", or "utm_<source>" stamped on /api/auth/signin call.
  signupSource String?
  // Referrer attribution — the existing createUser() block in auth.js
  // already writes to this column (line ~165) but the schema never had
  // it declared, so the write was silently swallowed. Self-relation
  // with onDelete: SetNull so deleting a referrer doesn't cascade.
  referredById String?
  referredBy   User?     @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  referrals    User[]    @relation("UserReferrals")
  accounts      Account[]
  creations     Creation[]
  sessions      Session[]
  payments      Payment[]
  comments      Comment[]
  following     Follow[]   @relation("Follower")
  followers     Follow[]   @relation("Following")
  notifications     Notification[] @relation("NotifRecipient")
  notificationsSent Notification[] @relation("NotifActor")
  posts             Post[]
  reactions         Reaction[]
  pushSubscriptions PushSubscription[]
  musicTracks       MusicTrack[]
  creditTxns        CreditTransaction[]
  editorProjects    EditorProject[]

  // Daily-signups dashboard query is the hot read path
  // (SELECT WHERE createdAt >= NOW() - INTERVAL '24 hours' ORDER BY createdAt DESC)
  // so put a descending index on it.
  @@index([createdAt(sort: Desc)])
  @@index([country])
  @@index([signupSource])
  @@index([referredById])
}

// Append-only audit log for every credit movement on a User. Inserted in
// the same Prisma transaction as the User.credits update so the ledger
// can never drift from the balance. Use the SUM(delta) over this table
// to reconcile a user's expected balance against User.credits — any
// mismatch indicates a deduction site that forgot to log.
//
// reason: short snake_case tag (e.g. "video_generate", "prompt_expand",
//   "image_build", "music_generate", "stem_split", "voice_clean",
//   "stripe_purchase", "admin_grant", "signup_grant", "refund_video",
//   "refund_music", "userfault_charge").
// refType / refId: optional pointer to the row that caused this delta
//   (Creation.id, MusicTrack.id, Payment.stripeSessionId, etc.). Lets
//   us trace a single creation's debit + any later refund.
// note: free-text — error message for userfault rows, admin name for
//   admin grants, etc.
model CreditTransaction {
  id        String   @id @default(cuid())
  userId    String
  delta     Int
  reason    String
  refType   String?
  refId     String?
  note      String?  @db.Text
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([reason])
  @@index([refType, refId])
}

// Editor projects from edits.visualseffect.com. A project = the entire
// timeline state (clips + tracks + filters + audio + text) the user can
// resume editing later. Phase 1 stores everything in the `timeline` Json
// blob — we don't query inside it, so no separate Clip table yet.
//
// Lifecycle:
//   DRAFT      — being edited. Autosave keeps `timeline` fresh every ~5s.
//   EXPORTING  — set when Export is clicked. Phase 1 finishes export
//                client-side via FFmpeg.wasm, then PATCHes back to
//                EXPORTED + writes exportedUrl. Phase 2 server worker
//                will hold the row in EXPORTING longer.
//   EXPORTED   — last export succeeded. exportedUrl points at R2.
//   FAILED     — last export failed. Credits already refunded by the
//                CreditTransaction ledger (reason="refund_editor_export").
//
// `lastEditedAt` is denormalized from `updatedAt` so the project list
// can sort by recency without scanning the timeline blob.
enum EditorProjectStatus {
  DRAFT
  EXPORTING
  EXPORTED
  FAILED
}

model EditorProject {
  id            String              @id @default(cuid())
  userId        String
  name          String              @default("Untitled project")
  timeline      Json
  aspectRatio   String              @default("16:9")
  durationSec   Float               @default(0)
  thumbnailUrl  String?
  status        EditorProjectStatus @default(DRAFT)
  exportedUrl   String?
  exportedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  lastEditedAt  DateTime            @default(now())

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastEditedAt(sort: Desc)])
  @@index([status])
}

model Creation {
  id          String   @id @default(cuid())
  prompt      String
  imageUrl    String?
  aspectRatio String?
  resolution  String?
  createdAt   DateTime @default(now())
  userId      String
  error       String?
  requestId   String?  @unique
  status      String   @default("processing")
  duration    Int?
  quality     String?
  audioFiles  String[]
  videoFiles  String[]
  inputImages String[]
  featured    Boolean  @default(false)
  // Phase 3 music pairing — optional link to a paired MusicTrack
  // soundtrack. Read by /v/[id] to play synced audio under the video.
  // SetNull on the track's delete so we never cascade-destroy videos.
  musicTrackId String?
  musicTrack   MusicTrack? @relation(fields: [musicTrackId], references: [id], onDelete: SetNull)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments    Comment[]
  notifications Notification[]

  @@index([userId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@index([musicTrackId])
}

// Community follow graph — Instagram-style follower / following relationships.
// Owned by seedance-community at community.visualseffect.com.
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

// Community comments — added by seedance-community at community.visualseffect.com.
// Polymorphic: attached to a Creation (video) OR a community Post. Exactly
// one of creationId / postId is set; enforced at the community API layer.
model Comment {
  id         String    @id @default(cuid())
  body       String
  userId     String
  creationId String?
  postId     String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  creation   Creation? @relation(fields: [creationId], references: [id], onDelete: Cascade)
  post       Post?     @relation(fields: [postId],     references: [id], onDelete: Cascade)
  notifications Notification[]
  reactions     Reaction[]

  @@index([creationId, createdAt(sort: Desc)])
  @@index([postId,     createdAt(sort: Desc)])
  @@index([userId])
}

// Community-native posts — text + optional image, distinct from
// Creations (AI-generated videos owned by Seedance).
model Post {
  id        String     @id @default(cuid())
  body      String?
  imageUrl  String?
  userId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions Reaction[]
  comments  Comment[]
  // Mirrors the model owned by seedance-community — declared here so
  // the Studio Prisma client can read pinned-state when it shows
  // shared posts in /admin. Side-table, never touched by Studio code.
  pinned    PinnedPost?
  // Phase 2 — Instagram-style profile pin. Same comment as `pinned`
  // above: mirrored from community so the shared client stays valid.
  profilePin ProfilePin?

  @@index([userId])
  @@index([createdAt(sort: Desc)])
}

// Polymorphic reactions — exactly one of postId / commentId is set.
// Type is "like" | "love" (Facebook-style two-button affordance).
model Reaction {
  id        String   @id @default(cuid())
  userId    String
  type      String
  postId    String?
  commentId String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post?    @relation(fields: [postId],    references: [id], onDelete: Cascade)
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, postId, type])
  @@unique([userId, commentId, type])
  @@index([postId])
  @@index([commentId])
}

// Inbox-style notifications — Instagram/Facebook pattern.
// type values: "comment" | "follow" | "new_post"
model Notification {
  id         String   @id @default(cuid())
  userId     String   // recipient
  actorId    String   // user who triggered the action
  type       String
  creationId String?
  commentId  String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  user     User      @relation("NotifRecipient", fields: [userId],     references: [id], onDelete: Cascade)
  actor    User      @relation("NotifActor",     fields: [actorId],    references: [id], onDelete: Cascade)
  creation Creation? @relation(fields: [creationId], references: [id], onDelete: Cascade)
  comment  Comment?  @relation(fields: [commentId],  references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, read])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Tracks fulfilled Stripe checkout sessions — prevents double-crediting
// when both the webhook and the success-page verify endpoint run.
model Payment {
  id              String   @id @default(cuid())
  stripeSessionId String   @unique
  userId          String
  credits         Int
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Tracks site visitors — IP, geolocation, page, user agent
model Visit {
  id        String   @id @default(cuid())
  ip        String
  country   String?
  city      String?
  region    String?
  isp       String?
  page      String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([ip])
  @@index([createdAt])
}


// Admin-pinned posts for community.visualseffect.com. Owned by the
// community project — Studio mirrors the model so the shared Prisma
// client stays in sync after `db push` from either side. Studio code
// does not write to this table.
model PinnedPost {
  id         String   @id @default(cuid())
  postId     String   @unique
  pinnedById String
  kind       String   @default("feature")
  priority   Int      @default(100)
  reason     String?  @db.Text
  pinnedAt   DateTime @default(now())
  expiresAt  DateTime?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([priority, pinnedAt(sort: Desc)])
  @@index([expiresAt])
  @@index([pinnedById])
}

// Phase 2 — user profile pins (Instagram-style). Mirrored here so the
// Studio Prisma client stays valid after `db push`. Studio never
// writes to this table.
model ProfilePin {
  id        String   @id @default(cuid())
  userId    String
  postId    String   @unique
  position  Int      @default(100)
  pinnedAt  DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([userId, position])
  @@index([postId])
}


// AI music tracks generated via Suno API. See community/prisma/
// schema.prisma for the full lifecycle comment — this declaration
// mirrors the canonical one in seedance-community so both projects'
// Prisma clients agree on the shape.
model MusicTrack {
  id             String   @id @default(cuid())
  userId         String
  taskId         String   @unique
  audioId        String?
  title          String
  prompt         String?  @db.Text
  genre          String?
  mood           String?
  durationReq    Int
  actualDuration Int?
  isVocal        Boolean  @default(false)
  lyrics         String?  @db.Text
  tempo          Int?
  model          String   @default("V5")
  status         String   @default("processing")
  error          String?  @db.Text
  streamUrl      String?
  audioUrl       String?
  imageUrl       String?
  r2Url          String?
  credits        Int
  plays          Int      @default(0)
  // Phase 3 — owner-toggled "Publish to gallery" flag (default off).
  public         Boolean  @default(false)
  // Stem-split state (Phase 4 — vocal/instrumental separation).
  // Populated by /api/music/tracks/[id]/stems + /api/music/stems/callback
  // when the owner asks Suno to split a finished track into separate
  // vocal + instrumental WAVs (filmmakers want the instrumental under
  // dialogue; musicians want the vocal stem for remixing).
  //   • stemTaskId      — Suno's vocal-removal task id (for callback lookup)
  //   • stemStatus      — null | "processing" | "completed" | "failed"
  //   • vocalUrl        — R2-mirrored vocal-only mp3
  //   • instrumentalUrl — R2-mirrored instrumental-only mp3
  //   • stemError       — friendly error string surfaced in the UI on failure
  stemTaskId      String?
  stemStatus      String?
  // stemMode: null | "vocal" (2-stem) | "split" (12-stem)
  // Surfaces in the UI as "Basic split (vocal + instrumental)"
  // vs "Pro split (12 stems)". Determines which columns below
  // are populated.
  stemMode        String?
  // 2-stem split URLs (always populated when stemStatus=completed)
  vocalUrl        String?
  instrumentalUrl String?
  // 12-stem split URLs (populated only when stemMode="split").
  // Naming + order matches the engine's vocal_removal_info shape so
  // the callback handler can copy fields in a single sweep without
  // a hand-rolled mapping. Any individual URL can be null if the
  // engine couldn't isolate that stem on a given track (e.g. a
  // synthwave track may have null brassUrl + null woodwindsUrl).
  backingVocalsUrl String?
  drumsUrl         String?
  bassUrl          String?
  guitarUrl        String?
  keyboardUrl      String?
  stringsUrl       String?
  brassUrl         String?
  woodwindsUrl     String?
  percussionUrl    String?
  synthUrl         String?
  fxUrl            String?
  stemError       String?  @db.Text
  // Phase 4 feature 3 — A/B variations. The music engine returns 2
  // variants per generation call; we used to discard the 2nd. Now we
  // persist it as a sibling MusicTrack row and link it back to the
  // original via parentTrackId so the library can group them.
  // Null on originals + on standalone (single-variant) tracks. Non-null
  // means "this row is the alt take of parentTrackId".
  parentTrackId   String?
  // Studio Pro v2 — LALAL.AI-powered stem separation. Distinct from
  // the Suno-based stem columns above because they use different
  // upstream services + different stem taxonomies. studioStems is a
  // JSON column { vocals, drum, bass, piano, electric_guitar,
  // acoustic_guitar }, each value the R2-mirrored URL. Null when no
  // Studio split has been performed yet.
  studioStemTaskId String?
  studioStemStatus String?   // null | "processing" | "completed" | "failed"
  studioStems      Json?
  studioStemError  String?   @db.Text
  // Pro 9-stem mode (R6): when the user picks Pro split, we fire
  // ONE multistem call (the 6 standard stems) + 3 stem_separator
  // calls (synth/strings/wind). studioStemTaskIds holds all 4
  // task IDs as a JSON array; the check route polls them in one
  // batched LALAL /check/ call and only flips to "completed"
  // when every job is done. Null for legacy 6-stem splits — the
  // single studioStemTaskId above is the only ID those use.
  studioStemMode   String?   // null | "6stem" | "9stem"
  studioStemTaskIds Json?
  // Studio Pro voice-clean (LALAL /split/voice_clean/). Strips
  // background noise from a vocal recording. Separate from stem
  // split so the two operations don't step on each other —
  // user could split stems AND voice-clean the lead vocal on the
  // same track if they wanted.
  voiceCleanTaskId String?
  voiceCleanStatus String?   // null | "processing" | "completed" | "failed"
  voiceCleanUrl    String?   // R2-mirrored cleaned voice mp3
  voiceCleanError  String?   @db.Text
  // Studio Pro lead-vs-backing vocals split (LALAL stem_separator
  // with multivocal=lead_back). Returns up to 4 stems:
  //   { lead, backing, no_vocals, mix_no_lead }
  // Stored as a single JSON column for clean schema. Distinct from
  // studioStems (multistem) + voiceCleanUrl (single voice) so users
  // can run all three operations on the same track without colliding.
  vocalsSplitTaskId String?
  vocalsSplitStatus String?
  vocalsSplit       Json?
  vocalsSplitError  String?  @db.Text

  // Mix & Master (Phase 1 — Dolby.io Media Mastering API).
  // One mastered output per track at a time; re-mastering overwrites
  // the previous masterUrl + bumps masterTaskId. masterFormat captures
  // the output container/bitrate the user picked at start so the
  // download route can serve with the right Content-Type + extension.
  // masterLufs is the announced target (-14, -13, -9, -23 etc.) — the
  // achieved LUFS lands in masterMeta as Dolby measures it.
  masterTaskId   String?
  masterStatus   String?
  masterUrl      String?
  masterError    String?  @db.Text
  masterLufs     Int?
  masterGenre    String?
  masterFormat   String?
  masterMeta     Json?

  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  creations Creation[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@index([deletedAt])
  @@index([public, createdAt(sort: Desc)])
  @@index([stemTaskId])
  @@index([parentTrackId])
  @@index([studioStemTaskId])
  @@index([voiceCleanTaskId])
  @@index([vocalsSplitTaskId])
  @@index([masterTaskId])
}

// Web Push subscription for browser notifications. Mirrors the model
// owned by seedance-community (same shared Neon DB). The `origin`
// column scopes by app: "studio" rows are fanout targets for the
// Studio MuAPI webhook ("video ready" / failed / featured); existing
// "community" rows stay routed to the community fanout. Null in
// legacy rows is treated as community by the API for back-compat.
//
// One row per (userId, endpoint) since `endpoint` is globally unique
// — re-subscribing on the same device upserts on endpoint.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  // "studio" | "community" — null = legacy community row.
  origin    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, origin])
}


// Push-notification token registry. The mobile app (Capacitor) posts
// its FCM (Android) / APNS (iOS) token to /api/devices/register on
// launch. We send "your video is ready" + future engagement pushes
// by joining this on userId.
//
// Standalone — no relation back to User on purpose. Adding a Devices[]
// field on User would touch the auth-critical model and Arman has had
// 3 cookie-bloat incidents from auth-table migrations. Querying by
// userId from this side works fine without the back-reference.
model Device {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  platform   String   // "ios" | "android" | "web"
  appVersion String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  lastSeenAt DateTime @default(now())
  // Set when a push fails with INVALID_REGISTRATION / NotRegistered —
  // the cron sweeps these monthly. Null means token is still good.
  invalidAt  DateTime?

  @@index([userId])
  @@index([invalidAt])
}
